<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Deterministic>true</Deterministic>

    <Authors>SingUp_009</Authors>
    <Copyright>© SingUp_009</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/SingUp009/Moderato.Effects</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SingUp009/Moderato.Effects</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
