<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Moderato.Effects</AssemblyName>
    <RootNamespace>Moderato.Effects</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Moderato.Effects</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Effect System for C#</Description>
    <PackageTags>effect;effect-system;result;error-handling;union;discriminated-union;functional</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moderato.Results" Version="0.1.0-preview.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moderato.Effects.SourceGenerator\Moderato.Effects.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\Moderato.Effects.SourceGenerator\bin\$(Configuration)\netstandard2.0\Moderato.Effects.SourceGenerator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <InternalsVisibleTo Include="Moderato.Effects.Tests" />
  </ItemGroup>

</Project>
