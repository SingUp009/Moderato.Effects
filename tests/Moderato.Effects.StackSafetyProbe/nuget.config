<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- A cache of its own, so a stale package with the same version never stands in for the one just packed. -->
    <add key="globalPackagesFolder" value="../../artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Moderato.Effects" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
