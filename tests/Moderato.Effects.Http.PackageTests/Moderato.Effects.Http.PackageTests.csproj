<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moderato.Effects.Http" Version="$(ModeratoEffectsVersion)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(CheckAnalyzers)' != 'true'">
    <Compile Remove="Validation/Misuse.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CheckExhaustiveness)' != 'true'">
    <Compile Remove="Validation/IncompleteMapping.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CheckResponseTypes)' != 'true'">
    <Compile Remove="Validation/InvalidResponse.cs" />
  </ItemGroup>
</Project>
