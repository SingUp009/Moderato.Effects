<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moderato.Effects.EntityFrameworkCore" Version="$(ModeratoEffectsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <Compile Include="../../samples/Moderato.Effects.Sqlite.Cli/Orders.cs" Link="Orders.cs" />
    <Compile Include="../../samples/Moderato.Effects.Sqlite.Cli/OrdersDb.cs" Link="OrdersDb.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CheckErrorType)' != 'true'">
    <Compile Remove="InvalidError.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CheckAnalyzers)' != 'true'">
    <Compile Remove="Misuse.cs" />
  </ItemGroup>
</Project>
