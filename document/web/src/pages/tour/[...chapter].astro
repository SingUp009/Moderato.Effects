---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/tour.css';

export async function getStaticPaths() {
    const chapters = (await getCollection('tour')).sort((a, b) => a.id.localeCompare(b.id));
    return [
        { params: { chapter: undefined }, props: { current: chapters[0].id } },
        ...chapters.map((chapter) => ({ params: { chapter: chapter.id }, props: { current: chapter.id } })),
    ];
}

const { current } = Astro.props;
const isIndex = Astro.params.chapter === undefined;
const sources = import.meta.glob<string>('/src/content/tour/*.cs', { query: '?raw', import: 'default', eager: true });
const chapters = await Promise.all(
    (await getCollection('tour'))
        .sort((a, b) => a.id.localeCompare(b.id))
        .map(async (entry) => {
            const code = sources[`/src/content/tour/${entry.id}.cs`];
            if (code === undefined) throw new Error(`Tour chapter ${entry.id} has no ${entry.id}.cs`);
            return { id: entry.id, title: entry.data.title, code, Content: (await render(entry)).Content };
        }),
);
const index = chapters.findIndex((chapter) => chapter.id === current);
const frontmatter = {
    title: isIndex ? 'Tour of Moderato.Effects' : `Tour: ${chapters[index].title}`,
    description: isIndex
        ? 'Learn Moderato.Effects step by step by editing and running C# in the browser.'
        : `${chapters[index].title}: an interactive Moderato.Effects lesson you can edit and run in the browser.`,
    template: 'splash' as const,
    prev: false as const,
    next: false as const,
};
const data = chapters.map(({ id, title, code }) => ({ id, title, code }));
---

<StarlightPage frontmatter={frontmatter}>
    <div class="tour" data-runner="/tour/runner/worker.js">
        <nav class="tour-nav not-content" aria-label="Tour chapters">
            <a class="tour-prev" href={index > 0 ? `/tour/${chapters[index - 1].id}/` : undefined} rel="prev" aria-disabled={index === 0}>← Previous</a>
            <span class="tour-position"><span data-tour-position>{index + 1}</span> / {chapters.length}</span>
            <a class="tour-next" href={index < chapters.length - 1 ? `/tour/${chapters[index + 1].id}/` : undefined} rel="next" aria-disabled={index === chapters.length - 1}>Next →</a>
        </nav>
        <div class="tour-split">
            <div class="tour-text">
                {chapters.map(({ id, title, Content }, i) => (
                    <article data-tour-chapter={id} hidden={i !== index}>
                        <h2>{i + 1}. {title}</h2>
                        <Content />
                    </article>
                ))}
            </div>
            <section class="tour-play not-content" aria-label="Code playground">
                <div class="tour-progress" data-tour-progress>
                    <progress max="100" value="0" aria-label="Loading the C# compiler"></progress>
                </div>
                <div class="tour-toolbar">
                    <button type="button" class="tour-run" data-tour-run disabled>Run</button>
                    <button type="button" class="tour-reset" data-tour-reset>Reset</button>
                    <span class="tour-status" data-tour-status role="status">Loading the C# compiler…</span>
                </div>
                <div class="tour-editor" data-tour-editor></div>
                <pre class="tour-output" data-tour-output aria-live="polite"></pre>
            </section>
        </div>
        <script type="application/json" data-tour-chapters set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    </div>
</StarlightPage>

<script>
    import { mountTour } from '../../components/tour/tour';

    mountTour(document.querySelector<HTMLElement>('.tour')!);
</script>
